APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# A2 Hosting cPanel mailbox (admin: pay stubs, timesheet reviews, newsletters).
# Username = full mailbox address. Password = that mailbox's password.
# Outgoing: mail.gennextglobaltech.ca  SMTP 465 (SSL/smtps). Auth required.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_ENCRYPTION=ssl
MAIL_HOST=mail.gennextglobaltech.ca
MAIL_PORT=465
MAIL_USERNAME=noreply@gennextglobaltech.ca
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@gennextglobaltech.ca"
MAIL_FROM_NAME="R&B Services Plus"
# Optional extra inboxes for driver adjustment / document-approve alerts (comma-separated)
MAIL_ADMIN_NOTIFY=

# Driver pay stub email: comma-separated CC (also set per-tenant under Settings → Company profile)
PAY_STUB_EMAIL_CC=
PAY_STUB_EMAIL_FROM_NAME="R&B Finance"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Used in driver review emails (links to the Next.js app)
FRONTEND_URL=http://localhost:3001

# Extra browser origins allowed to call the API (comma-separated). Localhost and
# gennextglobaltech.ca / randbservicesplus.ca are already included.
CORS_ALLOWED_ORIGINS=

# Website form entries are emailed using the MAIL_* transport above.
WEBSITE_FORM_NOTIFICATION_EMAIL=info@gennextglobaltech.ca
